{
  "name": "sanctions-screening-service",
  "version": "1.0.1",
  "description": "AML/sanctions screening REST API — screens names against OFAC, EU, UK, UN, India, and UAE watchlists.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "bun run scripts/build.ts",
    "rebuild": "bun run scripts/clean.ts && bun run scripts/build.ts",
    "clean": "bun run scripts/clean.ts",
    "audit:refresh": "rm -f bun.lock && bun install && bun audit",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "start:stdio": "MCP_TRANSPORT_TYPE=stdio node dist/index.js",
    "start:http": "MCP_TRANSPORT_TYPE=http node dist/index.js",
    "mirror:init": "bun run scripts/mirror-init.ts",
    "mirror:refresh": "bun run scripts/mirror-refresh.ts",
    "mirror:verify": "bun run scripts/mirror-verify.ts",
    "mirror:seed": "bun run scripts/mirror-seed.ts",
    "mirror:load-india-uae": "bun run scripts/mirror-load-india-uae.ts"
  },
  "license": "Apache-2.0",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@cyanheads/mcp-ts-core": "^0.12.3",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.0",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@socketsecurity/bun-security-scanner": "^1.1.2",
    "@types/node": "26.2.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "depcheck": "^1.4.7",
    "fast-check": "^4.9.0",
    "ignore": "^7.0.6",
    "tsc-alias": "^1.9.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
